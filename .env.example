# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The web app MUST connect as a role WITHOUT the BYPASSRLS attribute. Combined
# with FORCE ROW LEVEL SECURITY on tenant-scoped tables, this is what makes
# cross-tenant reads impossible even when application code has a bug.
DATABASE_URL="postgresql://skillgaps_app:skillgaps_app_dev@localhost:5432/skillgaps"

# Migration / seed connection. Owns the schema and has BYPASSRLS.
# Used ONLY by scripts/, never by the running application.
MIGRATION_DATABASE_URL="postgresql://skillgaps_owner:skillgaps_owner_dev@localhost:5432/skillgaps"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# "local"    -> self-hosted email + password sessions (dev / air-gapped pilots)
# "supabase" -> Supabase Auth issues the JWT; this app verifies and maps it
AUTH_PROVIDER="local"

# Required when AUTH_PROVIDER=local. Generate with: openssl rand -base64 48
AUTH_SESSION_SECRET="dev-only-change-me-dev-only-change-me-dev-only!!"

# Required when AUTH_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_JWT_SECRET=""

# ---------------------------------------------------------------------------
# Judge0 — sandboxed execution of student-submitted code.
# Submitted code is NEVER executed in the application process.
# If unset, coding questions fall back to "submit without running".
# ---------------------------------------------------------------------------
JUDGE0_URL=""
JUDGE0_API_KEY=""
JUDGE0_API_HOST=""

# ---------------------------------------------------------------------------
# Observability (both optional; features no-op when unset)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ---------------------------------------------------------------------------
# PHASE 2
# ---------------------------------------------------------------------------

# Background job queue. Without Redis, Phase 2 work queues but never runs, and
# the UI reports it as pending rather than failing silently.
REDIS_URL="redis://127.0.0.1:6379"
WORKER_CONCURRENCY="4"

# Python parser service (services/parser). Resume PDFs and JD keyword
# extraction go here; the main app never parses documents itself.
PARSER_SERVICE_URL="http://localhost:8000"
# Set in any deployment where the service is reachable beyond localhost.
PARSER_SERVICE_TOKEN=""

# Interview evaluation method: "rubric" | "model" | "manual".
# Unset defaults to "model" when Anthropic credentials exist, "rubric" otherwise.
EVALUATION_METHOD=""
# Required for the model evaluator.
ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------------------
# Object storage for resumes (S3, Supabase Storage, MinIO).
# When S3_BUCKET is unset, files are written to ./.storage for local
# development — the interface is identical either way.
# ---------------------------------------------------------------------------
S3_BUCKET=""
S3_REGION="ap-south-1"
# Set for Supabase Storage / MinIO and other S3-compatible endpoints.
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# DPDP data minimisation: resumes are purged this many days after upload.
RESUME_RETENTION_DAYS="180"
