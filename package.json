{
  "name": "skillgaps",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "test": "vitest run",
    "worker": "tsx --tsconfig tsconfig.worker.json --env-file=.env.local src/worker/index.ts",
    "py:dev": "cd services/parser && uvicorn app.main:app --reload --port 8000"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "next": "15.5.25",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.0",
    "zod": "^3.25.0",
    "recharts": "^3.10.1",
    "jose": "^6.0.11",
    "@sentry/nextjs": "^9.30.0",
    "posthog-js": "^1.250.0",
    "bullmq": "^5.56.0",
    "ioredis": "^5.6.0",
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/s3-request-presigner": "^3.850.0",
    "@anthropic-ai/sdk": "^0.124.0"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/pg": "^8.15.0",
    "@tailwindcss/postcss": "^4",
    "tailwindcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "@eslint/eslintrc": "^3",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.0",
    "vitest": "^3.2.0",
    "dotenv": "^16.5.0"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
